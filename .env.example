# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it contains secrets.

# ── Clerk (https://dashboard.clerk.com → API Keys) ─────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ── Convex (filled in automatically by `npx convex dev`) ───────────
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
# Note: these two are NOT set here — add them in the
# Convex dashboard → Settings → Environment Variables (dev and prod):
#   CLERK_WEBHOOK_SECRET     = whsec_...
#   CLERK_JWT_ISSUER_DOMAIN  = https://your-instance.clerk.accounts.dev

# ── Stream Video (https://dashboard.getstream.io) ─────────────────
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_SECRET_KEY=your_stream_secret_key

# ── Google Gemini (https://aistudio.google.com/apikey) ────────────
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Model used for question generation and interview feedback.
# Change it here only — no code changes needed.
GEMINI_MODEL=gemini-3.1-flash-lite
# Used automatically when the main model is overloaded ("high demand").
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ── VAPI voice agent (https://dashboard.vapi.ai) ──────────────────
NEXT_PUBLIC_VAPI_WEB_TOKEN=your_vapi_public_web_token

# ── Feature switches ───────────────────────────────────────────────
# VAPI voice interviews use paid credits. "false" (default) shows a
# "limit reached" notice on the call screen and offers the written
# interview instead; set to "true" to bring voice interviews back.
NEXT_PUBLIC_VOICE_INTERVIEW_ENABLED=false
